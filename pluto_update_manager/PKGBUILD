# Maintainer: Vince Richter <vince@77z.dev>

pkgname=pluto-update-manager
pkgver=1.15
pkgrel=2
epoch=
pkgdesc="PlutoOS Update Manager"
arch=(x86_64)
url="https://pluto.77z.dev"
license=('MIT')
options=(debug !strip) # dart needs debug symbols

build() {
	cd "$startdir"
	dart compile exe bin/pluto_update_manager.dart
}

package() {
	install -Dm644 "$startdir/pluto-enable-swap.service" "$pkgdir/usr/lib/systemd/system/pluto-enable-swap.service"
	mkdir -p "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s "/usr/lib/systemd/system/pluto-enable-swap.service" "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/pluto-enable-swap.service"

	install -Dm4755 "$startdir/bin/pluto_update_manager.exe" "$pkgdir/pluto/pluto_update_manager"
}
