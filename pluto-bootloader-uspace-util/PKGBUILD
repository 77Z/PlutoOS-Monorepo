# Maintainer: Vince Richter <vince@77z.dev>

pkgname=pluto-bootloader-backend
pkgver=1.3
pkgrel=1
pkgdesc="PlutoOS Bootloader Backend"
arch=(x86_64)
url="https://pluto.77z.dev"
license=('MIT')
options=(debug !strip) # dart needs debug symbols

build() {
	cd "$startdir"
	dart compile exe bin/pluto_bootloader_backend.dart
}

package() {
	install -Dm755 "$startdir/bin/pluto_bootloader_backend.exe" "$pkgdir/usr/bin/pluto_bootloader_backend"
	install -Dm755 "$startdir/plutoos-mark-good.service" "$pkgdir/usr/lib/systemd/system/plutoos-mark-good.service"
# 	ln -sv "/usr/lib/systemd/system/plutoos-mark-good.service" "etc/systemd/system/multi-user.target.wants/plutoos-mark-good.service"
}
