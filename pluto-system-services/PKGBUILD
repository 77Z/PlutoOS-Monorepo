# Maintainer: Vince Richter <vince@77z.dev>

# These are not the only system services that pluto has custom enabled.
# Some pluto packages will enable themselves (eg. pluto-bootloader-backend)

pkgname=pluto-system-services
pkgver=2025.12.16
pkgrel=1
pkgdesc='PlutoOS System Services'
arch=('any')
license=('MIT')
url='https://pluto.77z.dev'
depends=()
backup=()
source=()
sha256sums=()

package() {
  local group link mode source_file user

  declare -A symlinks
  declare -A directories

  directories=(
    ["etc/systemd/system"]="755:0:0"
    ["etc/systemd/system/multi-user.target.wants"]="755:0:0"
    ["etc/systemd/system/graphical.target.wants"]="755:0:0"
    ["etc/systemd/system/bluetooth.target.wants"]="755:0:0"
  )

  symlinks=(
    ["etc/systemd/system/default.target"]="usr/lib/systemd/system/graphical.target"

    ["etc/systemd/system/multi-user.target.wants/avahi-daemon.service"]="/usr/lib/systemd/system/avahi-daemon.service"
    ["etc/systemd/system/multi-user.target.wants/NetworkManager.service"]="/usr/lib/systemd/system/NetworkManager.service"
    ["etc/systemd/system/multi-user.target.wants/thermald.service"]="/usr/lib/systemd/system/thermald.service"
    ["etc/systemd/system/multi-user.target.wants/cups.socket"]="/usr/lib/systemd/system/cups.socket"
    ["etc/systemd/system/multi-user.target.wants/plutoos-mark-good.service"]="/usr/lib/systemd/system/plutoos-mark-good.service"

    ["etc/systemd/system/multi-user.target.wants/tlp.service"]="/usr/lib/systemd/system/tlp.service"
    ["etc/systemd/system/graphical.target.wants/tlp-pd.service"]="/usr/lib/systemd/system/tlp-pd.service"

    ["etc/systemd/system/display-manager.service"]="/usr/lib/systemd/system/sddm.service"

    ["etc/systemd/system/bluetooth.target.wants/bluetooth.service"]="/usr/lib/systemd/system/bluetooth.service"
    ["etc/systemd/system/dbus-org.bluez.service"]="/usr/lib/systemd/system/bluetooth.service"
  )

  cd "$pkgdir"

  for dir in "${!directories[@]}"; do
    mode="$(cut -f 1 -d ':' <<< "${directories[$dir]}")"
    user="$(cut -f 2 -d ':' <<< "${directories[$dir]}")"
    group="$(cut -f 3 -d ':' <<< "${directories[$dir]}")"

    install -vdm "$mode" -o "$user" -g "$group" "$dir"
  done

  for link in "${!symlinks[@]}"; do
    ln -sv "${symlinks[$link]}" "$link"
  done
}

# vim:set ts=2 sw=2 et:
