package() {
  local group link mode source_file user
  declare -A directories
  declare -A files

  # associative array with directories and their assigned mode, user and group
  # all paths are relative to the root directory /
  directories=(
    ["etc/sddm.conf.d"]="755:0:0"
    ["etc/rauc"]="755:0:0"
    ["usr/lib/systemd/system"]="755:0:0"
    ["etc/systemd/system.conf.d"]="755:0:0"
    ["chainloader"]="755:0:0"
    ["pluto"]="755:0:0"
  )

  # associative array of target files, their source file, file mode, user and group ownership
  files=(
    ["etc/sddm.conf.d/10-wayland.conf"]="10-wayland.conf:644:0:0"
    ["etc/sddm.conf.d/kde_settings.conf"]="kde_settings.conf:644:0:0"
    ["etc/rauc/system.conf"]="system.conf:644:0:0"
    ["etc/locale.conf"]="locale.conf:644:0:0"
    ["usr/lib/systemd/system/etc.mount"]="etc.mount:644:0:0"
    ["usr/lib/systemd/system/var.mount"]="var.mount:644:0:0"
    ['etc/systemd/system.conf.d/10-pluto.conf']="10-pluto.conf:644:0:0"
    ['etc/rauc/pluto-prod.cert.pem']="pluto-prod.cert.pem:644:0:0"
    ['usr/share/color-schemes/PlutoOSDark.colors']='PlutoOSDark.colors:644:0:0'
    ['usr/share/desktop-directories/PlutoOS.directory']='PlutoOS.directory:644:0:0'
  )

  cd "$pkgdir"

  for dir in "${!directories[@]}"; do
    mode="$(cut -f 1 -d ':' <<< "${directories[$dir]}")"
    user="$(cut -f 2 -d ':' <<< "${directories[$dir]}")"
    group="$(cut -f 3 -d ':' <<< "${directories[$dir]}")"

    install -vdm "$mode" -o "$user" -g "$group" "$dir"
  done

  for target_file in "${!files[@]}"; do
    source_file="$(cut -f 1 -d ':' <<< "${files[$target_file]}")"
    mode="$(cut -f 2 -d ':' <<< "${files[$target_file]}")"
    user="$(cut -f 3 -d ':' <<< "${files[$target_file]}")"
    group="$(cut -f 4 -d ':' <<< "${files[$target_file]}")"

    install -vDm "$mode" -o "$user" -g "$group" "$srcdir/$source_file" "$target_file"
  done
}

