arch=('any')
license=('MIT')
url='https://pluto.77z.dev'
depends=()
backup=()
source=(
  '10-wayland.conf'
  'kde_settings.conf'
  'system.conf'
  'locale.conf'
  'locale.gen'
  'etc.mount'
  'var.mount'
  '10-pluto.conf'
  'pluto-prod.cert.pem'
  'PlutoOSDark.colors'
  'PlutoOS.directory'
  'vconsole.conf'
)
